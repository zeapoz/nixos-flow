// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  // ===========================================================================
  // Prompt & Picker
  // ===========================================================================
  {
    "bindings": {
      "ctrl-j": "vim::MenuSelectNext",
      "ctrl-k": "vim::MenuSelectPrevious",
    },
  },
  {
    "context": "TabSwitcher",
    "bindings": {
      "c": "tab_switcher::CloseSelectedItem",
    },
  },
  {
    "context": "((Editor && VimControl) || ProjectPanel || EmptyPane) && !Picker",
    "bindings": {
      // ===========================================================================
      // Editor
      // ===========================================================================
      "space f": "file_finder::Toggle",
      "space .": "file_finder::Toggle",
      "space ,": "tab_switcher::Toggle",
      "space /": "pane::DeploySearch",
      "space e": "vim::ToggleProjectPanelFocus",
      "space s": "outline::Toggle",
      "space S": "project_symbols::Toggle",
      "space x": "diagnostics::Deploy",
      "space X": "diagnostics::DeployCurrentFile",
      "space t": "terminal_panel::ToggleFocus",
      "space ;": "command_palette::Toggle",
      "space j": "journal::NewJournalEntry",
      "space n": "workspace::NewFile",
      "space p": "projects::OpenRecent",
      "space o": "task::Spawn",
      "space u k": "zed::OpenKeymapFile",
      "space u s": "zed::OpenSettingsFile",
      // ===========================================================================
      // Git
      // ===========================================================================
      "space g g": "git_panel::ToggleFocus",
      "space g d": "git::Diff",
      "] h": "editor::GoToHunk",
      "[ h": "editor::GoToPreviousHunk",
      // ===========================================================================
      // Toggle Options
      // ===========================================================================
      "space u t": "editor::ToggleTabBar",
      "space u m": "editor::ToggleMinimap",
      "space u l": "editor::ToggleRelativeLineNumbers",
      "space u i": "editor::ToggleInlayHints",
      "space u L": "editor::ToggleLineNumbers",
      "space u d": "editor::ToggleInlineDiagnostics",
      "space u D": "editor::ToggleDiagnostics",
      "space u w": "editor::ToggleSoftWrap",
      "ctrl-j": "workspace::ToggleLeftDock",
      "ctrl-k": "workspace::ToggleRightDock",
      // ===========================================================================
      // Coding
      // ===========================================================================
      "space space": "editor::SelectEnclosingSymbol",
      "space r": "editor::Rename",
      "] d": "editor::GoToDiagnostic",
      "[ d": "editor::GoToPreviousDiagnostic",
      "] e": [
        "editor::GoToDiagnostic",
        {
          "severity": {
            "min": "hint",
            "max": "error",
          },
        },
      ],
      "[ e": [
        "editor::GoToPreviousDiagnostic",
        {
          "severity": {
            "min": "hint",
            "max": "error",
          },
        },
      ],
      // ===========================================================================
      // Panes
      // ===========================================================================
      "H": "pane::ActivatePreviousItem",
      "L": "pane::ActivateNextItem",
      "space w p": "workspace::ActivatePreviousPane",
      "space w h": "workspace::ActivatePaneLeft",
      "space w H": "workspace::MovePaneLeft",
      "space w l": "workspace::ActivatePaneRight",
      "space w L": "workspace::MovePaneRight",
      "space w j": "workspace::ActivatePaneDown",
      "space w J": "workspace::MovePaneDown",
      "space w k": "workspace::ActivatePaneUp",
      "space w K": "workspace::MovePaneUp",
      "space w v": "pane::SplitVertical",
      "space w s": "pane::SplitHorizontal",
      "space w q": "pane::CloseAllItems",
      "space w c": "pane::CloseActiveItem",
      "space w o": "pane::CloseOtherItems",
      "space w a": "workspace::CloseAllItemsAndPanes",
      "space w +": "vim::ResizePaneUp",
      "space w -": "vim::ResizePaneDown",
      "space w =": "vim::ResetPaneSizes",
      "space w >": "vim::ResizePaneRight",
      "space w <": "vim::ResizePaneLeft",
    },
  },
  // ===========================================================================
  // Project Panel
  // ===========================================================================
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "a": "project_panel::NewFile",
      "A": "project_panel::NewDirectory",
      "d": "project_panel::Delete",
      "c": "project_panel::Copy",
      "x": "project_panel::Cut",
      "p": "project_panel::Paste",
      "r": "project_panel::Rename",
      "v": "project_panel::OpenSplitVertical",
      "s": "project_panel::OpenSplitHorizontal",
    },
  },
  // ===========================================================================
  // Terminal
  // ===========================================================================
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-k": "terminal_panel::Toggle",
      "ctrl-j": "workspace::ToggleLeftDock",
      "ctrl-w h": "workspace::ActivatePaneLeft",
      "ctrl-w l": "workspace::ActivatePaneRight",
      "ctrl-w j": "workspace::ActivatePaneDown",
      "ctrl-w k": "workspace::ActivatePaneUp",
      "ctrl-w +": "vim::ResizePaneUp",
      "ctrl-w -": "vim::ResizePaneDown",
      "ctrl-w =": "vim::ResetPaneSizes",
      "ctrl-w >": "vim::ResizePaneRight",
      "ctrl-w <": "vim::ResizePaneLeft",
      "ctrl-w q": "pane::CloseAllItems",
      "ctrl-w c": "pane::CloseActiveItem",
      "ctrl-w a": "pane::CloseAllItems",
      "ctrl-w n": "workspace::NewTerminal",
      // Zellij-like bindings
      "ctrl-t n": "workspace::NewTerminal",
      "ctrl-t h": "pane::ActivatePreviousItem",
      "ctrl-t l": "pane::ActivateNextItem",
      "ctrl-t x": "pane::CloseActiveItem",
      "ctrl-t r": "terminal::RenameTerminal",
    },
  },
  // ===========================================================================
  // Search
  // ===========================================================================
  {
    "context": "Pane",
    "bindings": {
      "ctrl-r": "search::ToggleReplace",
      "ctrl-f": "project_search::ToggleFilters",
    },
  },
  // ===========================================================================
  // Completion
  // ===========================================================================
  {
    "context": "Editor && edit_prediction_conflict",
    "bindings": {
      "tab": "editor::AcceptEditPrediction",
    },
  },
  // ===========================================================================
  // Agent
  // ===========================================================================
  {
    "context": "(VimControl && !menu) || (!Editor && !Terminal)",
    "bindings": {
      "space a": "agent::ToggleFocus",
    },
  },
  {
    "context": "VimControl && vim_mode == visual",
    "bindings": {
      "space a": "agent::AddSelectionToThread",
    },
  },
  // ===========================================================================
  // Misc
  // ===========================================================================
  {
    // https://github.com/zed-industries/zed/pull/43618#issuecomment-3662435510
    "context": "!ProjectSearchBar",
    "bindings": {
      "space": null,
      "ctrl-w": null,
      "ctrl-t": null,
      "ctrl-p": null,
      "ctrl-n": null,
    },
  },
]
